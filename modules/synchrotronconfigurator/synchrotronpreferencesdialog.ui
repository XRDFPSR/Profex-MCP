       <item row="0" column="0" colspan="2">
        <widget class="QCheckBox" name="checkBoxSaveCurves">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;When saving a configuration to a *.pxsml file, the raw data of the Pseudo-Voigt and convolved profiles can be saved in the file.&lt;/p&gt;&lt;p&gt;*.pxsml files without raw curves require computation and fitting of the profiles after loading, but the file size is small.&lt;/p&gt;&lt;p&gt;*.pxsml files with raw curves load the profiles and fitted curves immediately, but the file size can be relatively large.&lt;/p&gt;&lt;p&gt;If unsure, leave this option disabled.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Save raw curves to XML configuration files</string>
         </property>
        </widget>
       </item>
