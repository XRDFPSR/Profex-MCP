              </item>
              <item row="3" column="1">
               <widget class="QComboBox" name="comboBoxDetectorMaterial">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Detector material&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Select the material of the detector surface. It is required for calculation of the linear absorption coefficient (LAC).&lt;/p&gt;&lt;p&gt;Additional materials can be added in the preferences.&lt;/p&gt;&lt;p&gt;If the material is unknown, but the LAC is known, leave this value at &amp;lt;unknown&amp;gt; and enter the value for the LAC directly.&lt;/p&gt;&lt;p&gt;If neither the material nor the LAC are known, the positional correction and correction of detector transparency will be skipped.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
               </widget>
              </item>
              <item row="4" column="0">
               <widget class="QLabel" name="labelLac">
                <property name="text">
                 <string>Linear Absorption Coefficient:</string>
                </property>
               </widget>
              </item>
              <item row="4" column="1">
               <widget class="QDoubleSpinBox" name="doubleSpinBoxLAC">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Linear absorption coefficient (LAC)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;The absorption coefficient in cm&lt;span style=&quot; vertical-align:super;&quot;&gt;-1&lt;/span&gt; for the selected wavelength in the selected detector material.&lt;/p&gt;&lt;p&gt;The value is calculated from the detector material. If the material is &amp;lt;unknown&amp;gt;, a value for the LAC can be entered directly.&lt;/p&gt;&lt;p&gt;If the LAC is unknown or 0.0, the positional correction and correction for detector transparency will be skipped.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="suffix">
                 <string> cm-1</string>
                </property>
                <property name="decimals">
                 <number>4</number>
                </property>
                <property name="maximum">
                 <double>999.990000000000009</double>
                </property>
                <property name="singleStep">
                 <double>0.100000000000000</double>
                </property>
               </widget>
              </item>
              <item row="5" column="0" colspan="2">
               <widget class="QGroupBox" name="groupBoxDetectorExpertOptions">
                <property name="title">
                 <string>Expert Options</string>
                </property>
                <layout class="QGridLayout" name="gridLayout_4">
                 <item row="2" column="0">
                  <widget class="QLabel" name="label_6">
