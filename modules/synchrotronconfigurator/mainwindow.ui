                 </item>
                 <item row="2" column="1">
                  <widget class="QCheckBox" name="checkBoxTransparencyCutoff">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Detector transparency cutoff&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Restrict the intensity distribution within the detector layer to the layer thickness (only available for convolution correction).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="text">
                    <string>Apply cutoff</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="0">
                  <widget class="QLabel" name="label_3">
                   <property name="text">
                    <string>Positional Correction:</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1">
                  <widget class="QComboBox" name="comboBoxPosCorrectionMode">
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Positional correction&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Apply a positional correction of the profiles due to absorption in the sensitive layer of the detector. Two different implementations are offered:&lt;/p&gt;&lt;p&gt;- Convolution of the Pseudo-Voigt profile with an exponential decay function (eqs. 20 and 21 in Chernyshov et al. 2021)&lt;/p&gt;&lt;p&gt;- Approximation with an exGaussian function (eq. 22 in Chernyshov et al. 2021)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
