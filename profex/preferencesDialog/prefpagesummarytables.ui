          <widget class="QDoubleSpinBox" name="doubleSpinBoxLOD">
           <property name="toolTip">
            <string>Relative Standard Deviation (ESD/Value) above which the value will be marked as &quot;Below Limit of Detection (LOD)&quot;.

Default = 0.50</string>
           </property>
           <property name="decimals">
            <number>3</number>
