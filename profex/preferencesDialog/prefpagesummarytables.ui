         <item row="2" column="0">
          <widget class="QLabel" name="labelMinEsd">
           <property name="text">
            <string>Minimum ESD (ignore ESDs below) =</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QDoubleSpinBox" name="doubleSpinBoxMinEsd">
           <property name="toolTip">
            <string>Refined ESDs below this value will be ignored, instead the value specified here will be used to determine LOQ and LOD. This can be used to avoid unreasonably low LOQs and LODs.

Set to 0.000 if all ESDs shall be used as refined.

Default: 0.050
</string>
           </property>
           <property name="suffix">
            <string> wt-%</string>
           </property>
           <property name="decimals">
            <number>3</number>
           </property>
           <property name="maximum">
