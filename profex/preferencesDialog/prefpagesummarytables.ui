      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <widget class="QCheckBox" name="checkBoxShowLOWarn">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;If checked, a warning &amp;quot;&amp;lt; LOD&amp;quot; or &amp;quot;&amp;lt; LOQ&amp;quot; will be shown in the Global GOALs summary table if the relative standard deviation exceeds the limits specified below.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>Show warnings for values below detection and quantification limit</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QGridLayout" name="gridLayout">
         <item row="0" column="0">
          <widget class="QLabel" name="labelLOQ">
           <property name="text">
            <string>Variation coefficient for LOQ:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1">
          <widget class="QDoubleSpinBox" name="doubleSpinBoxLOQ">
           <property name="toolTip">
            <string>Relative Standard Deviation (ESD/Value) above which the value will be marked as &quot;Below Limit of Quantification (LOQ)&quot;.

Default = 0.25</string>
           </property>
           <property name="decimals">
            <number>3</number>
           </property>
           <property name="maximum">
            <double>5.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.250000000000000</double>
