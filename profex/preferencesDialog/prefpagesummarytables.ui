       <item>
        <widget class="QPlainTextEdit" name="plainTextEditBgmnOutputParameters">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Specify which local parameters and GOALs (phase specific refinement results) will be summarized in the table and exported to CSV. Parameters must be specified as regular expression patterns.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Example: To export unit cell parameters and the crystallite size, enter&lt;/span&gt;&lt;/p&gt;&lt;p&gt;^A$&lt;br/&gt;^B$&lt;br/&gt;^C$&lt;br/&gt;^ALPHA$&lt;br/&gt;^BETA$&lt;br/&gt;^GAMMA$&lt;br/&gt;^GrainSize\(\d+,\d+,\d+\)$&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
