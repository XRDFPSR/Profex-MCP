       <item>
        <widget class="QPlainTextEdit" name="plainTextEditBgmnGlobalGoals">
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Specify which global GOALs are listed in the summary tables. The GOAL name must be specified as a regular expression pattern. &lt;/p&gt;&lt;p&gt;Delete all text to list all GOALs.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Example: list all goals of type &amp;quot;PhaseName/sum&amp;quot;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;^[^\/]+\/sum$&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Example: list all EPS values&lt;/span&gt;&lt;/p&gt;&lt;p&gt;^EPS\d$&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
        </widget>
       </item>
