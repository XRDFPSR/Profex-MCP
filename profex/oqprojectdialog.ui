          <property name="text">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Introduction&lt;/span&gt;&lt;/p&gt;&lt;p&gt;This dialog guides through the operation qualification (OQ) to verify the basic operation of the Profex installation.&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;Visit the Profex website (&lt;a href=&quot;https://www.profex-xrd.org&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#0000ff;&quot;&gt;https://www.profex-xrd.org&lt;/span&gt;&lt;/a&gt;) for IQ and OQ protocols.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
